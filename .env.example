# ==============================================================================
# HoneyShield X — Unified Runtime Configuration Template
# ==============================================================================
# Copy this file to '.env' and customize.
# Runtime settings remain externalized and are never committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=honeyshield
POSTGRES_USER=honeyshield
POSTGRES_PASSWORD=your_secure_password_here

# Optional: Unified DATABASE_URL (takes precedence if defined)
# DATABASE_URL=postgresql+psycopg://honeyshield:your_secure_password_here@127.0.0.1:5432/honeyshield

# ------------------------------------------------------------------------------
# Redis Event Bus & Outbox Broker Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: Unified REDIS_URL (takes precedence if defined)
# REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# Application & Security Settings
# ------------------------------------------------------------------------------
HONEYSHIELD_ENV=development
HONEYSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

