<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.honeyshield.soc"
    android:versionCode="5"
    android:versionName="1.0.0-rc5">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <!-- Network & Push Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- QR Scanner & Biometric Step-Up Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
        android:name="com.honeyshield.soc.HoneyShieldApplication"
        android:label="HoneyShield X"
        android:icon="@drawable/icon"
        android:roundIcon="@drawable/adaptive_icon"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <activity
            android:name="com.honeyshield.soc.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Link Intent Filter for Pairing -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="honeyshield"
                    android:host="pairing" />
            </intent-filter>

            <!-- Deep Link Intent Filter for Alerts -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="honeyshield"
                    android:host="alert" />
            </intent-filter>
        </activity>

        <!-- Digital Agent Universe Sync Background Service -->
        <service
            android:name="com.honeyshield.soc.DigitalAgentSyncService"
            android:exported="false" />

    </application>
</manifest>
